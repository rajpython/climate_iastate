# ── large data trees ─────────────────────────────────────────────────────────
data/
outputs/

# ── virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── notebooks & docs ─────────────────────────────────────────────────────────
notebooks/
docs/
!docs/user_guide.md
!docs/user_guide.pdf
# Guides served by the dashboard (pages/guides.py reads these at runtime) — they
# must stay in the build context. Add a line when a new guide is registered.
!docs/dashboard_guide.md
!docs/marine_heatwave_guide.md
!docs/bottom_state_guide.md
# Research → Literature Summaries / Forecast Development read these at runtime.
!docs/mhw_forecasting_synthesis.md
!docs/mhw_forecasting_synthesis.pdf

# ── tests (not needed in image) ──────────────────────────────────────────────
tests/
.pytest_cache/

# ── editor / OS artefacts ────────────────────────────────────────────────────
.DS_Store
.git/
.gitignore
.vscode/
.idea/

# ── CI / Infra (not needed inside container) ─────────────────────────────────
.github/
infra/
scripts/
