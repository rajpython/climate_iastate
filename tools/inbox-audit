#!/usr/bin/env bash
# inbox-audit — detect handoffs addressed to `dashboard` that never landed in our inbox.
#
# WHY THIS EXISTS
# ---------------
# `handoff-send` closed the SENDER's blind spot: a leg that fails now exits non-zero and
# writes no ledger row, because a row implies delivery. The RECIPIENT's blind spot was
# declared unclosable — "no recipient-side monitor can ever catch a file that never moved"
# (mini, 2026-08-01). That is true of the filesystem alone, and false in this program,
# because the cells keep a SHARED, GIT-TRACKED MANIFEST of what was sent:
#   handoffs/INDEX.tsv        — one row per handoff, with a `to` column
#   handoffs/dashboard/to-dashboard/  — the tracked copy of every dashboard-addressed file
# So the recipient CAN reconcile "what the program says I was sent" against "what is on my
# disk", and fetch anything missing. That is this script.
#
# It was written after 2026-08-11, when admin's 20260810-02 never arrived while INDEX.tsv
# carried a row saying it had. The cells recovered that file by `git pull` (same repo);
# the dashboard cannot — climate_iastate is a DIFFERENT repo and no LOFRA machine clones
# it, so for us a skipped leg is terminal, not merely delayed. This closes that gap from
# our side, with no dependency on any sender remembering anything.
#
# READ-ONLY OUTSIDE OUR REPO. It reads the acfr clones (including the lofra-m4 cell tree
# that shares this machine) and never writes into them — reaching into a peer's working
# tree is the A-09 failure mode. Fetched files land only in our own docs/handoffs/.
#
# USAGE
#   tools/inbox-audit            # report only
#   tools/inbox-audit --fetch    # report, then retrieve anything missing (SHA-verified)
#   tools/inbox-audit --remote   # force reading the ledger from mini rather than the local clone
set -uo pipefail

FETCH=0; FORCE_REMOTE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --fetch) FETCH=1; shift ;;
    --remote) FORCE_REMOTE=1; shift ;;
    -h|--help) sed -n '1,30p' "$0"; exit 0 ;;
    *) echo "inbox-audit: unknown flag $1" >&2; exit 1 ;;
  esac
done

REPO="$(cd "$(dirname "$0")/.." && pwd)"
INBOX_ROOT="$REPO/docs/handoffs"
[ -d "$INBOX_ROOT" ] || { echo "inbox-audit: ERROR: $INBOX_ROOT not found" >&2; exit 1; }

LOCAL_ACFR="$HOME/dev/acfr"                       # the lofra-m4 cell clone on this machine
MINI_ACFR="~/dev/acfr"
MINI_ADMIN="~/dev/acfr-admin"

# --- the ledger: prefer mini's live copy (authoritative); fall back to the local clone ----
# The local clone is a peer cell's tree and may be behind; we never pull it to catch up.
LEDGER="$(mktemp)"; trap 'rm -f "$LEDGER"' EXIT
SRC=""
if [ "$FORCE_REMOTE" = "0" ] && [ -f "$LOCAL_ACFR/handoffs/INDEX.tsv" ]; then
  cp "$LOCAL_ACFR/handoffs/INDEX.tsv" "$LEDGER"; SRC="local acfr clone (may lag)"
fi
if remote_ledger="$(ssh -o ConnectTimeout=10 -o BatchMode=yes mini "cat $MINI_ACFR/handoffs/INDEX.tsv" 2>/dev/null)" \
   && [ -n "$remote_ledger" ]; then
  printf '%s\n' "$remote_ledger" > "$LEDGER"; SRC="mini:$MINI_ACFR/handoffs/INDEX.tsv (authoritative)"
fi
[ -n "$SRC" ] || { echo "inbox-audit: ERROR: no ledger reachable (tried mini, then $LOCAL_ACFR)" >&2; exit 1; }
echo "inbox-audit: ledger = $SRC"

# --- which rows are addressed to us? ------------------------------------------------------
# INDEX columns: ts  from  to  seq  filename  status   ('to' is a comma-separated cell list)
rows="$(awk -F'\t' 'NR>1 && $3 ~ /(^|,)dashboard(,|$)/ {print $2"\t"$5}' "$LEDGER")"
total="$(printf '%s' "$rows" | grep -c . || true)"
echo "inbox-audit: $total ledger rows addressed to dashboard"

# --- is each one on our disk? -------------------------------------------------------------
# Current convention files sit in from-<sender>/; pre-2026-07-21 files sit in the root.
missing=0; present=0; MISSING_LIST=""
while IFS=$'\t' read -r from file; do
  [ -n "$file" ] || continue
  if [ -f "$INBOX_ROOT/from-$from/$file" ] || [ -f "$INBOX_ROOT/$file" ] \
     || compgen -G "$INBOX_ROOT/from-*/$file" > /dev/null 2>&1; then
    present=$((present+1))
  else
    missing=$((missing+1)); MISSING_LIST="$MISSING_LIST$from	$file
"
    echo "  MISSING  [$from]  $file"
  fi
done <<< "$rows"

echo "inbox-audit: $present present, $missing MISSING"
[ "$missing" -eq 0 ] && { echo "inbox-audit: inbox reconciles with the program ledger."; exit 0; }

if [ "$FETCH" = "0" ]; then
  echo "inbox-audit: re-run with --fetch to retrieve them (SHA-256 verified against the source)." >&2
  exit 3
fi

# --- retrieve, verifying content against the source we pulled it from ---------------------
echo; echo "inbox-audit: fetching…"
failed=0
while IFS=$'\t' read -r from file; do
  [ -n "$file" ] || continue
  dest_dir="$INBOX_ROOT/from-$from"; mkdir -p "$dest_dir"
  got=""
  # 1) the git-tracked copy in the acfr clone on this machine (no network, read-only)
  for cand in "$LOCAL_ACFR/handoffs/dashboard/to-dashboard/$file" "$LOCAL_ACFR/handoffs/lofras/from-$from/$file"; do
    [ -f "$cand" ] && { cp "$cand" "$dest_dir/" && got="$cand"; break; }
  done
  # 2) mini: the research clone, then the admin plane
  if [ -z "$got" ]; then
    for rpath in "$MINI_ACFR/handoffs/dashboard/to-dashboard/$file" \
                 "$MINI_ADMIN/handoffs/dashboard/to-dashboard/$file" \
                 "$MINI_ACFR/handoffs/lofras/from-$from/$file"; do
      if scp -o ConnectTimeout=15 -q "mini:$rpath" "$dest_dir/" 2>/dev/null; then got="mini:$rpath"; break; fi
    done
  fi
  if [ -z "$got" ]; then
    echo "  UNRECOVERED  $file — not found in any known source" >&2; failed=$((failed+1)); continue
  fi
  # verify by content against the source, the same standard handoff-send applies to a send
  local_sha="$(shasum -a 256 "$dest_dir/$file" | awk '{print $1}')"
  case "$got" in
    mini:*) src_sha="$(ssh -o ConnectTimeout=10 mini "shasum -a 256 ${got#mini:} 2>/dev/null | awk '{print \$1}'")" ;;
    *)      src_sha="$(shasum -a 256 "$got" | awk '{print $1}')" ;;
  esac
  if [ "$local_sha" = "$src_sha" ]; then
    echo "  RECOVERED  $file  <- $got  (sha ${local_sha:0:16}… verified)"
  else
    echo "  SHA MISMATCH on $file from $got — removed" >&2; rm -f "$dest_dir/$file"; failed=$((failed+1))
  fi
done <<< "$MISSING_LIST"

echo
if [ "$failed" -gt 0 ]; then
  echo "inbox-audit: $failed file(s) could not be recovered — raise with the sender." >&2; exit 4
fi
echo "inbox-audit: all missing handoffs recovered. Commit them for the audit trail, then read them."
