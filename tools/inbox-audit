#!/usr/bin/env bash
# inbox-audit — collect mail addressed to `dashboard` that never reached our inbox.
#
# WHY THIS EXISTS
# ---------------
# This machine is a laptop that sleeps in and out constantly, around the clock (its own
# power log shows 30-85 sleep events per 4-hour block, day and night). Senders deliver by
# pushing a file over ssh. So a delivery to us fails whenever we happen to be asleep, which
# is often, at any hour. That is expected and is not going to change: sleep stays as the
# operator wants it. What must change is that we go and collect what did not arrive.
#
# WHAT IT LOOKS AT, AND WHY NOT THE LEDGER
# ----------------------------------------
# The first version of this script reconciled against the shared ledger (INDEX.tsv). That
# was the WRONG SHELF, and provably so:
#   * When a push fails because we are asleep, handoff-send correctly writes NO ledger row
#     -- it files a PENDING-DELIVERY.tsv slip instead. A ledger-based check is blind to
#     exactly the case that happens most often here.
#   * A ledger row can also be written without a delivery (admin's 20260810-02, 2026-08-11).
# So a ledger row is neither necessary nor sufficient. This version ignores bookkeeping and
# compares MAIL TO MAIL: every file in the LOFRA handoff tree whose filename ADDRESSES
# dashboard, against what is on our disk. On its first run that found three m1 handoffs
# stranded since 2026-07-20/21 that the ledger-based check had reported nothing about.
#
# Addressing is read from the filename marker only -- the part before the date field --
# so a file that merely mentions "dashboard" in its topic slug is not mistaken for our mail.
#
# READ-ONLY OUTSIDE OUR REPO. It reads the acfr clones, including the lofra-m4 cell tree
# that shares this machine, and never writes into them (A-09). Recovered files land only in
# our own docs/handoffs/.
#
# USAGE
#   tools/inbox-audit            # report only; exit 3 if anything is missing
#   tools/inbox-audit --fetch    # report, then retrieve each missing file, SHA-verified
#   tools/inbox-audit --local    # skip the ssh sweep of mini (offline / fast)
set -uo pipefail

FETCH=0; LOCAL_ONLY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --fetch) FETCH=1; shift ;;
    --local) LOCAL_ONLY=1; shift ;;
    -h|--help) sed -n '1,40p' "$0"; exit 0 ;;
    *) echo "inbox-audit: unknown flag $1" >&2; exit 1 ;;
  esac
done

REPO="$(cd "$(dirname "$0")/.." && pwd)"
INBOX_ROOT="$REPO/docs/handoffs"
[ -d "$INBOX_ROOT" ] || { echo "inbox-audit: ERROR: $INBOX_ROOT not found" >&2; exit 1; }

LOCAL_ACFR="$HOME/dev/acfr/handoffs"          # lofra-m4's clone, git-synced, on this machine
MINI_ACFR="~/dev/acfr/handoffs"
MINI_ADMIN="~/dev/acfr-admin/handoffs"

# --- does this filename ADDRESS dashboard? (marker only, not the topic slug) -------------
# current : <sender>-to-<rcpt>[-cc-<others>]-YYYYMMDD-NN-<slug>.md
# legacy  : YYYY-MM-DD_<sender>-to-<rcpt>_<slug>.md
addresses_dashboard() {
  local base="$1" marker
  case "$base" in
    20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*) marker="${base#*_}"; marker="${marker%%_*}" ;;
    *) marker="${base%%-20[0-9][0-9][0-9][0-9][0-9][0-9]-*}"; [ "$marker" = "$base" ] && return 1 ;;
  esac
  case "$marker" in
    dashboard-to-*) return 1 ;;                 # our own outbound
    *dashboard*)    return 0 ;;
    *)              return 1 ;;
  esac
}

on_our_disk() {
  local f="$1" c
  for c in "$INBOX_ROOT"/from-*/"$f" "$INBOX_ROOT/$f"; do [ -f "$c" ] && return 0; done
  return 1
}

sender_of() {  # from-<sender> inbox this file belongs in
  local base="$1"
  case "$base" in
    20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*) local m="${base#*_}"; echo "${m%%-to-*}" ;;
    *) echo "${base%%-to-*}" ;;
  esac
}

# --- gather every candidate filename from every place mail for us can sit ----------------
CAND="$(mktemp)"; SRCMAP="$(mktemp)"; trap 'rm -f "$CAND" "$SRCMAP"' EXIT
scan_local() {
  [ -d "$LOCAL_ACFR" ] || return 0
  find "$LOCAL_ACFR" -name '*.md' -not -path '*/from-dashboard/*' 2>/dev/null |
    while read -r p; do printf '%s\t%s\n' "$(basename "$p")" "$p"; done
}
scan_mini() {
  [ "$LOCAL_ONLY" = "1" ] && return 0
  ssh -o ConnectTimeout=10 -o BatchMode=yes mini \
    "find $MINI_ACFR $MINI_ADMIN -name '*.md' -not -path '*/from-dashboard/*' 2>/dev/null" 2>/dev/null |
    while read -r p; do [ -n "$p" ] && printf '%s\tmini:%s\n' "$(basename "$p")" "$p"; done
}
{ scan_local; scan_mini; } > "$SRCMAP"
[ -s "$SRCMAP" ] || { echo "inbox-audit: ERROR: no handoff source readable (local clone or mini)" >&2; exit 1; }
awk -F'\t' '{print $1}' "$SRCMAP" | sort -u > "$CAND"

echo "inbox-audit: scanned $(wc -l < "$CAND" | tr -d ' ') handoff files across $( [ "$LOCAL_ONLY" = 1 ] && echo 'the local clone' || echo 'the local clone + mini (acfr, acfr-admin)')"

# --- which are addressed to us, and which of those are absent? ---------------------------
MISSING=""; addressed=0; missing=0
while read -r f; do
  addresses_dashboard "$f" || continue
  addressed=$((addressed+1))
  on_our_disk "$f" && continue
  missing=$((missing+1)); MISSING="$MISSING$f
"
  echo "  MISSING  [$(sender_of "$f")]  $f"
done < "$CAND"
echo "inbox-audit: $addressed addressed to dashboard · $((addressed-missing)) present · $missing MISSING"

# --- the senders' own failed-delivery slips, as a second signal --------------------------
slips() {
  { [ -f "$LOCAL_ACFR/PENDING-DELIVERY.tsv" ] && cat "$LOCAL_ACFR/PENDING-DELIVERY.tsv"
    [ "$LOCAL_ONLY" = "1" ] || ssh -o ConnectTimeout=10 -o BatchMode=yes mini \
        "cat $MINI_ACFR/PENDING-DELIVERY.tsv $MINI_ADMIN/PENDING-DELIVERY.tsv 2>/dev/null" 2>/dev/null
  } | awk -F'\t' 'NR>0 && $3 ~ /(^|,)dashboard(,|$)/ {print "  SLIP  "$2" -> "$4}' | sort -u
}
s="$(slips)"
[ -n "$s" ] && { echo; echo "inbox-audit: senders have recorded failed deliveries TO US:"; echo "$s"; }

[ "$missing" -eq 0 ] && { echo "inbox-audit: nothing outstanding — every handoff addressed to us is on our disk."; exit 0; }
if [ "$FETCH" = "0" ]; then
  echo "inbox-audit: re-run with --fetch to collect them (SHA-256 verified against the source)." >&2
  exit 3
fi

# --- collect, verifying content against the source --------------------------------------
echo; echo "inbox-audit: collecting…"
failed=0
while read -r f; do
  [ -n "$f" ] || continue
  dest="$INBOX_ROOT/from-$(sender_of "$f")"; mkdir -p "$dest"
  src="$(awk -F'\t' -v n="$f" '$1==n {print $2; exit}' "$SRCMAP")"
  [ -n "$src" ] || { echo "  UNRECOVERED  $f — no source" >&2; failed=$((failed+1)); continue; }
  if [ "${src#mini:}" != "$src" ]; then
    scp -o ConnectTimeout=15 -q "mini:${src#mini:}" "$dest/" 2>/dev/null || {
      echo "  UNRECOVERED  $f — scp failed" >&2; failed=$((failed+1)); continue; }
    src_sha="$(ssh -o ConnectTimeout=10 mini "shasum -a 256 '${src#mini:}' | awk '{print \$1}'" 2>/dev/null)"
  else
    cp "$src" "$dest/" 2>/dev/null || { echo "  UNRECOVERED  $f — copy failed" >&2; failed=$((failed+1)); continue; }
    src_sha="$(shasum -a 256 "$src" | awk '{print $1}')"
  fi
  got_sha="$(shasum -a 256 "$dest/$f" | awk '{print $1}')"
  if [ "$got_sha" = "$src_sha" ]; then
    echo "  COLLECTED  $f  <- $src  (sha ${got_sha:0:16}… verified)"
  else
    echo "  SHA MISMATCH  $f — discarded" >&2; rm -f "$dest/$f"; failed=$((failed+1))
  fi
done <<< "$MISSING"

echo
[ "$failed" -gt 0 ] && { echo "inbox-audit: $failed could not be collected — raise with the sender." >&2; exit 4; }
echo "inbox-audit: collected. Commit them for the audit trail, then READ them — they are unhandled inbound."
